# Optional. Tracestrack topographic tiles for the coordination map (https://console.tracestrack.com).
# Without it the map uses public OpenStreetMap tiles, plus Esri satellite.
EXPO_PUBLIC_TRACESTRACK_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
